DIFY_BASE_URL=
DIFY_API_KEY=
# Pi knowledge retrieval uses a knowledge API key, not the workflow app key.
PI_KNOWLEDGE_MODE=dify
DIFY_KNOWLEDGE_BASE_URL=https://api.dify.ai/v1
DIFY_KNOWLEDGE_API_KEY=
DIFY_DATASET_ID=
# Pi uses a separate OpenRouter model key, not the Dify application key.
PI_MODEL_API_KEY=
PI_MODEL=deepseek/deepseek-chat
PI_BUSINESS_BASE_URL=http://127.0.0.1:3000
# Local business service starts automatically. Set http to use an existing service.
PI_BUSINESS_MODE=embedded
PI_WEB_PORT=5180
PORT=5174

# Business API uses a separate local port; hosted platforms may supply PORT.
BUSINESS_API_PORT=3000
# Include /v1/rdb/rest, but no table name or query string.
CLOUDBASE_BASE_URL=https://YOUR_ENV_ID.api.tcloudbasegateway.com/v1/rdb/rest
CLOUDBASE_TOKEN=
